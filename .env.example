# ==================================================
# TICKZEN DATABASE EXPORTER CONFIGURATION
# ==================================================
# Copy this to .env for local runs. On Azure these are set on the Container Apps job
# (deploy/azure/deploy_container_apps_job.sh); passwords/keys go in as secrets.

# Azure PostgreSQL (production stock database used by the ticker pages)
AZURE_POSTGRES_HOST=tickzen-stock-data-v2.postgres.database.azure.com
AZURE_POSTGRES_PORT=5432
AZURE_POSTGRES_DB=tickzen-data
AZURE_POSTGRES_USER=jadaunkg
AZURE_POSTGRES_PASSWORD=your_azure_postgres_password
AZURE_POSTGRES_SSLMODE=require
# Alternatively a single URL (takes precedence over the fields above):
# AZURE_POSTGRES_URL=postgresql://jadaunkg:<password>@tickzen-stock-data-v2.postgres.database.azure.com:5432/tickzen-data?sslmode=require

# Financial and Macro API Keys
FINNHUB_API_KEY=your_finnhub_key_here
FRED_API_KEY=your_fred_key_here

# Runner. The stock list comes from the monitored_tickers table (is_active = true).
# This worker's number (0-based) and the total number of workers (same value on every worker):
WORKER_INDEX=0
WORKER_COUNT=1
# After finishing its own part, help with stale stocks of the other parts:
HELP_OTHER_WORKERS=true
# Every Yahoo request from this worker is spaced evenly to stay under this rate:
YAHOO_REQUESTS_PER_HOUR=1200
# Export window in New York time: weekdays from START (after the 16:00 close) to STOP (before the 09:30 open), all weekend:
EXPORT_START_ET=16:30
EXPORT_STOP_ET=09:00
# Hourly batches: each run exports at most this many stocks, stops starting new ones after this many minutes,
# then waits for the next hourly start (the job runs at :30 every hour):
STOCKS_PER_RUN=70
RUN_TIME_BUDGET_MINUTES=55
# End the run after this many real HTTP 429 answers from Yahoo (each one also pauses 60 s and halves the pace):
STOP_AFTER_429=3
# End the run after this many stocks in a row fail with a rate-limit error:
MAX_CONSECUTIVE_RATE_LIMITED=3

# Pipeline switches (same meaning as in tickzen-github).
# Workers run from different IPs, so give each its own in-process Yahoo/Finnhub limiter:
TICKZEN_RATE_LIMIT_BACKEND=local
# TICKZEN_UNIT_GUARD=enforce
# YF_USE_CUSTOM_SESSION=false
